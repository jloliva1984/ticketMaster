#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP — Cambia la URL a la de tu dominio/subdominio real
#--------------------------------------------------------------------
app.baseURL = 'https://tudominio.com/'
app.forceGlobalSecureRequests = false
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'tm_session'
app.sessionExpiration = 7200
app.sessionSavePath = null
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false
app.CSRFTokenName = 'csrf_token'
app.CSRFCookieName = 'csrf_cookie'
app.CSRFExpire = 7200
app.CSRFRegenerate = true

#--------------------------------------------------------------------
# DATABASE — Usa los datos de tu panel de Hostinger
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = u123456789_ticketmaster
database.default.username = u123456789_ticketmaster
database.default.password = TU_CONTRASEÑA_SEGURA
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------
# ENCRYPTION KEY — Genera una con: php spark key:generate
# Pega aquí el valor que te dé el comando
#--------------------------------------------------------------------
encryption.key = hex2bin:1b67aedde52e008b3fc57b46d5ef73d365dfb1fa551358ec85eb6acec4adade7
